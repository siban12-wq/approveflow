# AICTE ApproveFlow — copy to .env. Never commit real secrets.

APP_NAME=AICTE ApproveFlow
APP_ENV=demo
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# true = SQLite file (easy local demo). false = PostgreSQL.
USE_SQLITE=true
DATABASE_URL=postgresql+psycopg://approveflow:approveflow@localhost:5432/approveflow
SQLITE_PATH=./approveflow.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://siban12-wq.github.io,https://approveflow-project.netlify.app

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# ML & OCR Engine Configuration
ML_MODEL_PATH=app/ml/breach_risk_model.joblib
ML_METADATA_PATH=app/ml/model_metadata.json

SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@approveflow.demo

# Job interval in seconds (120 = 2 minutes in demo)
JOB_INTERVAL_SECONDS=120
DEMO_MODE=true
CLOCK_OFFSET_DAYS=0
